<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>AIGuard.NET</PackageId>
    <Version>0.1.0</Version>
    <Authors>AIGuard.NET Contributors</Authors>
    <Description>Enterprise-grade safety guardrails, zero-allocation PII redaction, SQL/code injection detection, and content validation middleware for .NET and Microsoft.Extensions.AI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;llm;guardrails;safety;pii;security;sql-injection;middleware</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
  </ItemGroup>

</Project>
