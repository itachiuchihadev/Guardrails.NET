<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Guardrails.NET</PackageId>
    <Version>0.1.0</Version>
    <Authors>Guardrails.NET Contributors</Authors>
    <Description>Enterprise-grade safety guardrails, prompt injection detection, PII &amp; secrets redaction, SQL injection defense, schema validation, and context steering middleware for .NET and Microsoft.Extensions.AI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>ai;llm;guardrails;safety;pii;security;sql-injection;middleware</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

</Project>
